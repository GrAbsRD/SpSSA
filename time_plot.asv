%%
dd = 50:10:500;
load("time.mat");

fig = figure('Units','pixels', 'Position', [100, 100, 850, 800]);

color_map = lines;
markers = {'o','s','^','d','v','>','p'};
for i = 1:7
    idx = 1:length(dd);
    if i == 2 || i == 4
        lw = 1.5;
    else
        lw = 1.2;
    end
    % plot(dd(idx), tt(i,idx), ...
    %     '-','LineWidth',lw, ...
    %     'Color',[0 0 0], ...
    %     'Marker',markers{i}, ...
    %     'MarkerFaceColor',[1 1 1], ...   % 白心
    %     'MarkerEdgeColor',[0 0 0], ...
    %     'MarkerSize',6);
    plot(dd(idx), tt(i,idx), ...
        '-','LineWidth',lw, ...
        'Color',[0 0 0], ...
        'Marker',markers{i}, ...
        'MarkerFaceColor',[1 1 1], ...   % 白心
        'MarkerEdgeColor',[0 0 0], ...
        'MarkerSize',6);
    hold on
end

% 每一条曲线对应一个名字
lgd_names = { ...
    'SGMD', ...            % i = 1
    'SpSSA$_{\tau=1}$', ... % i = 2
    'SpSSA$_{\tau=2}$', ... % i = 3
    'SpSSA$_{\tau=3}$', ... % i = 4
    'SpSSA$_{\tau=1}$(ext)', ...     % i = 5
    'SpSSA$_{\tau=2}$(ext)', ...     % i = 6
    'SpSSA$_{\tau=3}$(ext)' ...      % i = 7
};
xlim([45, 505])
xticks(dd)
labels = string(dd);
labels(mod(dd,50)~=0) = "";
xticklabels(labels)
xlabel("Embedding dimesion")
ylabel("Running time (s)")
legend(lgd_names, 'Interpreter','latex','Location', 'northwest','FontSize',16);
set(gca,'fontsize',16,'LineWidth',1.0,'TickLength',[0.01, 0.02],'Box','on')

