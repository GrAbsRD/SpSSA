clc
clear
close all

fs = 5120;
time = 1;
t = 0:1/fs:time-1/fs;
x = zeros(fs, 3);
x(:, 1) = 2*(1+0.5*(sin(2*pi*t))).*sin(60*pi*t);
x(:, 2) = sin(120*pi*t);
x(:, 3) = 0.5*cos(10*pi*t);
sig = sum(x, 2);

%% signal 1
dd = 50:10:500;
n = length(dd);
tt = zeros(7, n);

